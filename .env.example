# Azure DevOps PAT for local development/testing
# In production, tokens come from Foundry OAuth Identity Passthrough via Authorization header
AZURE_DEVOPS_PAT=

# Default ADO organisation (used when org not specified in tool calls)
AZURE_DEVOPS_ORG=your-org-name

# Server config
MCP_SERVER_PORT=3000

# API key for endpoint protection (optional for local dev, required in production)
# Generated by Terraform and stored in Key Vault. Set this to require
# X-API-Key header on all MCP requests. Leave empty to skip validation.
MCP_API_KEY=
